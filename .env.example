# JWT Configuration
# Generate a strong, random secret key for production:
#   openssl rand -base64 32
JWT_SECRET=change-me-to-a-secure-random-secret-key

# Duration in hours that issued JWT tokens stay valid (default: 24).
JWT_VALID_TIME=24

# Argon2 Master-Password Pepper
# A server-side secret mixed into every Argon2 hash. Keep it out of the
# database and rotate it only together with all user passwords.
# Generate one with: openssl rand -base64 32
PASSWORD_PEPPER=change-me-to-a-long-random-pepper

# Vault Encryption Key
# Base64-encoded 32-byte ChaCha20-Poly1305 key used to encrypt vault entries.
# Required. Generate one with: openssl rand -base64 32
# Losing this key makes every stored vault password unrecoverable.
VAULT_KEY=replace-with-a-base64-encoded-32-byte-key

# Database Configuration
# The API creates the file and applies init.sql on startup.
DATABASE_URL=sqlite://keydungeon.db

# Database Backups
# A consistent snapshot is written here every 6 hours; the newest 3 are kept.
# The API creates the directory if it does not exist.
BACKUP_DIR=./backups
BACKUP_MAX_FILES=3
# Also take a catch-up snapshot on startup when no backup exists or the newest
# one is older than 6 hours. Set to false to disable.
BACKUP_ON_START=true

# Logging Level
# Options: off, error, warn, info, debug, trace (or per-target filters).
RUST_LOG=info,tower_http=info

# Local Port
PORT=4321
