# JWT Configuration
# Generate a strong, random secret key for production
# You can use: openssl rand -base64 32
JWT_SECRET=change-me-to-a-secure-random-secret-key

# JWT Token Valid Time
# Duration in hours that JWT tokens are valid
# If not set, defaults to 24 hours
JWT_VALID_TIME=24

# Bcrypt Configuration
#
# BCRYPT_COST: The computational cost factor for bcrypt password hashing
# - Higher values = more secure but slower (more CPU intensive)
# - Lower values = faster but less secure
# - Valid range: 4-31
# - Default: 12 (recommended for most applications)
#
# Cost levels:
#   4-6:    Very fast, but less secure (only for testing)
#   10-12:  Good balance of speed and security (recommended)
#   13-15:  Strong security, slight performance impact
#   16-20:  Very strong security, noticeable performance impact
#   21+:    Extreme security, significant performance impact (20+ seconds per hash)
#
# Example values:
# - Development: 10-12
# - Production: 12-14
# - High security: 15+

BCRYPT_COST=12

# Database Configuration
POSTGRES_USER=test
POSTGRES_PASSWORD=test
POSTGRES_DB=test
DATABASE_URL=postgres://test:test@postgres:5432/test

# Logging Level
# Options: off, error, warn, info, debug, trace
RUST_LOG=warn
